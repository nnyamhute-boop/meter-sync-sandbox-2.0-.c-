<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="AxisNugets" value="https://pkgs.dev.azure.com/axissol/_packaging/AxisNugets/nuget/v3/index.json" />
  </packageSources>
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </auditSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Volo.*" />
    </packageSource>
    <packageSource key="AxisNugets">
      <package pattern="Axis.*" />
      <package pattern="Mtume.*" />
      <package pattern="AccountsLedger.*" />
      <package pattern="NominalLedger.*" />
      <package pattern="Volo.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
